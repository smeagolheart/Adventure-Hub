// Yard outside the inn. Arriving here (the campaign start, or C:MoveToArea("S9YARD")
// while testing) plays the opening cutscene once. The yard is always night and rain.

IF
  OnCreation()
THEN
  RESPONSE #100
    DayNight(MIDNIGHT)
    Weather(RAIN)
    Continue()
END

IF
  Global("S9_OPENING_STARTED","GLOBAL",0)
THEN
  RESPONSE #100
    SetGlobal("S9_OPENING_STARTED","GLOBAL",1)
    DayNight(MIDNIGHT)
    Weather(RAIN)
    ClearAllActions()
    StartCutSceneMode()
    StartCutScene("S9CUT01")
END
