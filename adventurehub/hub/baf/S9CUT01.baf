// Opening cutscene: the party comes in out of the rain.
// Started by the S9YARD area script when the party first arrives in the yard.
// %yard_x% etc. are filled in at install time from the Friendly Arm Inn layout:
//   yard = just outside the inn door, step = a few steps toward it, hub = inside.

IF
  True()
THEN
  RESPONSE #100
    CutSceneId(Player1)
    FadeToColor([1.0],0)
    ActionOverride(Player2,JumpToPoint([%yard_x%.%yard_y%]))
    ActionOverride(Player3,JumpToPoint([%yard_x%.%yard_y%]))
    ActionOverride(Player4,JumpToPoint([%yard_x%.%yard_y%]))
    ActionOverride(Player5,JumpToPoint([%yard_x%.%yard_y%]))
    ActionOverride(Player6,JumpToPoint([%yard_x%.%yard_y%]))
    JumpToPoint([%yard_x%.%yard_y%])
    DayNight(MIDNIGHT)
    Weather(RAIN)
    MoveViewObject(Player1,INSTANT)
    Wait(1)
    FadeFromColor([30.0],0)
    Wait(2)
    DisplayStringHead(Player1,@300)
    Wait(3)
    ActionOverride(Player2,MoveToPoint([%step_x%.%step_y%]))
    ActionOverride(Player3,MoveToPoint([%step_x%.%step_y%]))
    ActionOverride(Player4,MoveToPoint([%step_x%.%step_y%]))
    ActionOverride(Player5,MoveToPoint([%step_x%.%step_y%]))
    ActionOverride(Player6,MoveToPoint([%step_x%.%step_y%]))
    MoveViewPoint([%step_x%.%step_y%],SLOW)
    MoveToPoint([%step_x%.%step_y%])
    FadeToColor([20.0],0)
    Wait(1)
    ActionOverride(Player2,LeaveAreaLUAPanic("S9HUB","",[%hub_x%.%hub_y%],N))
    ActionOverride(Player3,LeaveAreaLUAPanic("S9HUB","",[%hub_x%.%hub_y%],N))
    ActionOverride(Player4,LeaveAreaLUAPanic("S9HUB","",[%hub_x%.%hub_y%],N))
    ActionOverride(Player5,LeaveAreaLUAPanic("S9HUB","",[%hub_x%.%hub_y%],N))
    ActionOverride(Player6,LeaveAreaLUAPanic("S9HUB","",[%hub_x%.%hub_y%],N))
    LeaveAreaLUAPanic("S9HUB","",[%hub_x%.%hub_y%],N)
    Wait(1)
    MoveViewObject(Player1,INSTANT)
    FadeFromColor([20.0],0)
    SetGlobal("S9_OPENING_DONE","GLOBAL",1)
    EndCutSceneMode()
END
